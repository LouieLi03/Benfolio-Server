# Copy to .env and use absolute NAS paths. Do not put an API Key in this file.
BENFOLIO_SERVER_NAME=Benfolio
BENFOLIO_LIBRARY_NAME=书库
BENFOLIO_STATE_DIR=/absolute/path/benfolio-state
BENFOLIO_BOOKS_PATH=/absolute/path/books
BENFOLIO_API_KEY_PATH=/absolute/path/secrets/benfolio-api-key

# Use the NAS account that has real write access to STATE_DIR and read access
# to BOOKS_PATH and API_KEY_PATH. Do not grant permissions to everyone.
BENFOLIO_UID=10001
BENFOLIO_GID=10001

# Loopback by default. Choose a LAN address or reverse proxy when deploying.
BENFOLIO_BIND_ADDRESS=127.0.0.1
BENFOLIO_PORT=8080
BENFOLIO_VERSION=dev
